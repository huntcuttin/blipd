# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Cron auth — shared secret checked by every /api/cron/* route
CRON_SECRET=your-cron-secret

# cron-job.org — used by /api/cron/health-check to verify job health
CRON_JOB_ORG_API_KEY=your-cron-job-org-api-key

# Resend (email notifications)
RESEND_API_KEY=re_your_api_key
# Signing secret for the /api/webhooks/resend bounce/complaint webhook.
# Only needed once that webhook is configured in the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# App URL (used in email templates)
NEXT_PUBLIC_APP_URL=https://www.blippd.app

# Admin
ADMIN_EMAIL=you@example.com
# Where you actually want to receive test sends during development
TEST_EMAIL=you@example.com

# IGDB (via Twitch) — used for release dates, hype scores, ratings
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`
# Push silently no-ops if these are unset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:you@example.com

# Claude API — used for trailer-to-game matching in detect-trailers
ANTHROPIC_API_KEY=sk-ant-your-api-key
